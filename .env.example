# Application
NEXT_PUBLIC_APP_URL=http://localhost:3000
APP_NAME=PostTrust

# Clerk authentication
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_replace_me
CLERK_SECRET_KEY=sk_test_replace_me
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/

# Gemini API (server only)
GEMINI_API_KEY=replace_with_gemini_api_key
GEMINI_MODEL=gemini-2.5-flash

# Neon Postgres (server only)
DATABASE_URL=postgresql://user:password@host/database?sslmode=require

# Brevo purchase receipts / optional marketing emails (server only)
BREVO_API_KEY=replace_with_brevo_api_key
BREVO_SENDER_EMAIL=hello@example.com
BREVO_SENDER_NAME=PostTrust
BREVO_CONTACT_LIST_ID=replace_with_numeric_list_id
BREVO_PURCHASE_TEMPLATE_ID=replace_with_numeric_template_id

# Stripe server credentials
STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me

# Stripe catalog IDs (server only; never trust a price ID from the browser)
STRIPE_PRICE_QUICK_FIX=price_replace_quick_fix
STRIPE_PRICE_VOICE_AUDIT=price_replace_voice_audit
STRIPE_PRICE_MONTHLY_AUDIT=price_replace_monthly_audit

# Stripe-hosted Payment Link URLs (safe to expose in the browser)
NEXT_PUBLIC_STRIPE_LINK_QUICK_FIX=https://buy.stripe.com/test_replace_quick_fix
NEXT_PUBLIC_STRIPE_LINK_VOICE_AUDIT=https://buy.stripe.com/test_replace_voice_audit
NEXT_PUBLIC_STRIPE_LINK_MONTHLY_AUDIT=https://buy.stripe.com/test_replace_monthly_audit

# Optional analytics
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
